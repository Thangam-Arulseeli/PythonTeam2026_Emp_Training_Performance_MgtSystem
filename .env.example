APP_NAME=Employee Training and Performance Management System
APP_ENV=development
DEBUG=false # Disables debug mode 

DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=Python_Emp_Training_Performance_Management_DB
DB_USER=postgres
DB_PASSWORD=

DB_POOL_SIZE=5    # Keeps up to 5 connections available in the pool
DB_MAX_OVERFLOW=10  # Specifies how many additional connections SQLAlchemy can create temporarily when all pooled connections are occupied.
DB_POOL_TIMEOUT=30 # (sec) -- Specifies how long, SQLAlchemy waits to obtain a connection from the pool before raising a timeout error.

JWT_SECRET_KEY=
JWT_ALGORITHM=HS256

ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

CORS_ORIGINS=http://localhost:3000,http://localhost:5173


EXTERNAL_API_KEY=

EXTERNAL_API_TIMEOUT=5.0
EXTERNAL_API_MAX_RETRIES=2

LOG_LEVEL=INFO










